# ==============================================================================
# AI-CareerMatch Backend Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="AI-CareerMatch"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security & JWT Token
# Generate a secure 32-byte secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-this-in-production-to-a-very-long-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DB="aicareermatch_db"

# Resume Storage & Limits
UPLOAD_DIR="uploads/resumes"
MAX_FILE_SIZE_MB=5

# CORS Allowed Origins (Comma-separated for React Vite frontend)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
